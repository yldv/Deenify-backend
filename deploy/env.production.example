SECRET_KEY=
DEBUG=False

ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
DJANGO_USE_HTTPS=

DATABASE_URL=

BOT_TOKEN=
BOT_API_SECRET=
BACKEND_BASE_URL=
ADMIN_IDS=
# Bot username (without @) for referral deep links t.me/<username>?start=ref_<id>
BOT_USERNAME=DeenifyUzBot

ATMOS_TEST_MODE=False
    ATMOS_STORE_ID=
# Optional — Atmos may not issue a separate terminal for card-binding flow.
ATMOS_TERMINAL_ID=
ATMOS_CONSUMER_KEY=
ATMOS_CONSUMER_SECRET=
# Callback signature verification (incoming webhooks from Atmos). Register callback in partner.atmos.uz.
ATMOS_API_KEY=
ATMOS_CALLBACK_URL=https://api.frienfinity.uz/api/v1/payments/atmos/callback/
# After payment on checkout page — polls status, then redirects to Telegram bot
ATMOS_RETURN_URL=https://api.frienfinity.uz/api/v1/payments/atmos/return/
ATMOS_SUCCESS_REDIRECT_URL=https://t.me/DeenifyUzBot
ATMOS_BASE_URL=https://apigw.atmos.uz
# Prod: do NOT set ATMOS_CHECKOUT_PROXY_BASE (uses https://checkout.pays.uz directly).
ATMOS_PAYMENT_FLOW=merchant
# Recurring billing (card binding / token charges)
# OTP for merchant/pay/apply when charging a bound card token (sandbox: 111111).
ATMOS_TOKEN_PAYMENT_OTP=111111
ATMOS_RENEW_LEAD_DAYS=1
ATMOS_RENEW_FAIL_GRACE_DAYS=3
# Delete unpaid Atmos orders older than N days (daily cleanup timer; default 1 day)
ATMOS_STALE_ORDER_RETENTION_DAYS=1
# Delete subscription catalog bot messages after N seconds if not paid (default 1 hour)
OFFER_MESSAGE_TTL_SECONDS=3600
# Referral bonus days granted to the inviter on the invited user's first payment
ATMOS_REFERRAL_BONUS_DAYS_MONTHLY=10
ATMOS_REFERRAL_BONUS_DAYS_YEARLY=30

# Require premium after the free questions are used up (10 free, then must buy premium)
DEENIFY_QUIZ_SUBSCRIPTION_REQUIRED=True
DEENIFY_QUIZ_FIRST_ROUND_EASY_COUNT=10
