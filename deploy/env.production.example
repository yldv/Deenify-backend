# Skopiya: /var/www/deenify/.env
# cp deploy/env.production.example .env  && nano .env

SECRET_KEY=replace-with-python-secrets-token_urlsafe-50
DEBUG=False

ALLOWED_HOSTS=api.frienfinity.uz,frienfinity.uz,ВАШ_IP_СЕРВЕРА
# Until SSL: http://IP and DJANGO_USE_HTTPS=False. After certbot: https origins + True
CSRF_TRUSTED_ORIGINS=http://ВАШ_IP_СЕРВЕРА,https://api.frienfinity.uz,https://frienfinity.uz
DJANGO_USE_HTTPS=False

DATABASE_URL=postgres://deenify_user:DB_PASSWORD@127.0.0.1:5432/deenify_db

BOT_TOKEN=
# Must include /api/v1 — bot API paths are relative to this base (see .env.example)
BACKEND_BASE_URL=https://api.frienfinity.uz/api/v1
SUPPORT_PHONE=+998901234567
ADMIN_IDS=

ATMOS_STORE_ID=
ATMOS_CONSUMER_KEY=
ATMOS_CONSUMER_SECRET=
ATMOS_CALLBACK_URL=https://api.frienfinity.uz/api/v1/payments/atmos/callback/
ATMOS_RETURN_URL=https://t.me/your_bot
ATMOS_BASE_URL=https://partner.atmos.uz

DEENIFY_QUIZ_SUBSCRIPTION_REQUIRED=False
DEENIFY_QUIZ_FIRST_ROUND_EASY_COUNT=10
