SECRET_KEY=
DEBUG=False

ALLOWED_HOSTS=api.frienfinity.uz,frienfinity.uz
CSRF_TRUSTED_ORIGINS=
DJANGO_USE_HTTPS=

DATABASE_URL=

BOT_TOKEN=
BOT_API_SECRET=
BACKEND_PUBLIC_URL=https://your-domain.uz
BACKEND_BASE_URL=http://127.0.0.1:8001/api/v1
ADMIN_IDS=
# Bot username (without @) for referral deep links t.me/<username>?start=ref_<id>
BOT_USERNAME=DeenifyUzBot

# --- Click (my.click.uz -> Merchant cabinet) ---------------------------------
# Register the callback URL in the cabinet:
# https://your-domain.uz/api/v1/payments/click/callback/
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_MERCHANT_USER_ID=
CLICK_SECRET_KEY=
# Click's payment page; our checkout page posts a hidden form to this address.
CLICK_PAYMENT_URL=https://my.click.uz/services/pay
# Click redirects the customer here after the payment page (our own page).
CLICK_RETURN_URL=https://api.frienfinity.uz/api/v1/payments/click/return/
CLICK_CALLBACK_URL=https://api.frienfinity.uz/api/v1/payments/click/callback/
# Telegram deep link shown on the checkout / return pages.
CLICK_BOT_URL=https://t.me/DeenifyUzBot
# Interface language of the Click payment page: uz | ru | en
CLICK_LANG=uz
# Delete unpaid Click orders older than N days (daily cleanup timer; default 1 day)
CLICK_STALE_ORDER_RETENTION_DAYS=1
# Delete subscription catalog bot messages after N seconds if not paid (default 1 hour)
OFFER_MESSAGE_TTL_SECONDS=3600
# Referral bonus days granted to the inviter on the invited user's first payment
CLICK_REFERRAL_BONUS_DAYS_MONTHLY=10
CLICK_REFERRAL_BONUS_DAYS_YEARLY=30
# --- Test billing: monthly = 15 min. Revert after testing: ---
# DEENIFY_TEST_MONTHLY_RENEWAL_MINUTES=15

# Require premium after the free questions are used up (10 free, then must buy premium)
DEENIFY_QUIZ_SUBSCRIPTION_REQUIRED=True
DEENIFY_QUIZ_FIRST_ROUND_EASY_COUNT=10
