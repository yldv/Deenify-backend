[Unit]
Description=Deenify delete expired subscription offer messages
After=network.target postgresql.service

[Service]
Type=oneshot
User=deenify
Group=deenify
WorkingDirectory=/var/www/deenify
EnvironmentFile=/var/www/deenify/.env
ExecStart=/var/www/deenify/.venv/bin/python manage.py cleanup_expired_offer_messages
