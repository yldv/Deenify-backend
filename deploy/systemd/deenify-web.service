[Unit]
Description=Deenify Django (Gunicorn)
After=network.target postgresql.service

[Service]
User=deenify
Group=deenify
WorkingDirectory=/var/www/deenify
EnvironmentFile=/var/www/deenify/.env
ExecStart=/var/www/deenify/.venv/bin/gunicorn config.wsgi:application \
    --bind 127.0.0.1:8001 \
    --workers 2 \
    --timeout 180
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
